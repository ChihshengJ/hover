  p2 {"pageIndex":2,"type":2,"rect":{"origin":{"x":490.033,"y":635.499},"size":{"width":12.125,"height":10.903}},"target":{"type":"destination","destination":{"pageIndex":13,"zoom":{"mode":1,"params":{"x":50.112,"y":447.953,"zoom":0}},"view":[50.112,447.953,0]}},"strokeColor":"#00ff00","strokeWidth":0,"strokeStyle":0,"contents":"","flags":[],"blendMode":0}
  p2 {"pageIndex":2,"type":2,"rect":{"origin":{"x":503.98,"y":635.499},"size":{"width":12.125,"height":10.903}},"target":{"type":"destination","destination":{"pageIndex":13,"zoom":{"mode":1,"params":{"x":50.112,"y":411.786,"zoom":0}},"view":[50.112,411.786,0]}},"strokeColor":"#00ff00","strokeWidth":0,"strokeStyle":0,"contents":"","flags":[],"blendMode":0}
  p2 {"pageIndex":2,"type":9,"rect":{"origin":{"x":308.862,"y":680.2158},"size":{"width":237.8991,"height":32.9361}},"segmentRects":[{"origin":{"x":438.803,"y":680.2158},"size":{"width":107.958,"height":9.0261}},{"origin":{"x":308.862,"y":692.2904},"size":{"width":237.8991,"height":8.9066}},{"origin":{"x":308.862,"y":704.2454},"size":{"width":236.5984,"height":8.9066}}],"strokeColor":"#ffff00","color":"#ffff00","opacity":1,"author":"金之盛","contents":"Typically, the stem cell design is concerned with how the input images will be processed at the network’s beginning. Due to the redundancy inherent in natural images, a common stem cell will aggressively downsample the input images to an appropriate feature map size in both standard ConvNets and vision Transformers. The stem cell in standard ResNet contains a 7×7 convolution layer with stride 2, followed by a max pool, which results in a 4× downsampling of the input images. In vision Transformers, a more aggressive “patchify” strategy is used as the stem cell, which corresponds to a large kernel size (e.g. kernel size = 14 or 16) and non-overlapping convolution.","modified":"2026-11-20T23:40:10.000Z","flags":["print"],"blendMode":1,"appearanceModes":1}
