{
  "name": "hover-pdf",
  "version": "0.10.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "check:layers": "bun scripts/check_layering.mjs",
    "check": "bun run typecheck && bun run check:layers",
    "build": "vite build",
    "build:chrome": "TARGET=chrome vite build",
    "build:firefox": "TARGET=firefox vite build",
    "build:safari": "TARGET=safari vite build && bash scripts/build_safari.sh",
    "build:all": "bun run build:chrome && bun run build:firefox && bun run build:safari",
    "build:store": "STORE_BUILD=1 bun run build:all",
    "package": "bun run build:all && bun scripts/package.mjs",
    "watch:chrome": "TARGET=chrome vite build --watch",
    "dev:firefox": "bun run build:firefox && web-ext run --source-dir dist/firefox --firefox-profile '/Users/zs_jin/Library/Application Support/Firefox/profiles/bncnexsu.default-release' & TARGET=firefox vite build --watch",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "typescript": "^7.0.2",
    "vite": "^7.3.1",
    "web-ext": "^10.3.0"
  },
  "dependencies": {
    "@embedpdf/engines": "^2.15.0",
    "@embedpdf/pdfium": "^2.15.0",
    "@leeoniya/ufuzzy": "^1.0.19"
  }
}
